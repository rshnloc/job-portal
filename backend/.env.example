# Safe Development Environment Configuration
# NOTE: Replace placeholder values with your environment-specific values in production.
# NEVER commit production secrets or real API keys to source control.

PROJECT_NAME="NextHire Job Portal"
ENVIRONMENT="development"
PORT=8000
HOST="127.0.0.1"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Secret key used for JWT signing in development mode only
# In production, set a high-entropy secret via your secure secret manager
SECRET_KEY="dev_jwt_secret_key_for_local_testing_only"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL (Default: local SQLite database file, no credentials required)
DATABASE_URL="sqlite:///./job_portal.db"

